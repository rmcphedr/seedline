FROM python:3.11-slim
WORKDIR /app
COPY pyproject.toml ./
COPY apps ./apps
COPY backend ./backend
COPY configs ./configs
COPY data ./data
COPY infrastructure/alembic ./infrastructure/alembic
COPY alembic.ini ./
RUN pip install --no-cache-dir .
EXPOSE 8000
CMD ["uvicorn", "apps.api.main:app", "--host", "0.0.0.0", "--port", "8000"]
