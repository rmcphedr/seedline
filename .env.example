DATABASE_URL=postgresql+psycopg://bridge:bridge@localhost:5432/bridge
# Required for admin API and Basic-auth admin UI; use the same value for API and web.
ADMIN_API_KEY=
BRIDGE_WORKER_API_KEY=
WINDMILL_WORKSPACE=
WINDMILL_FLOW_PATH=f/bridge/enrich_funding_opportunity
WINDMILL_API_TOKEN=
WINDMILL_PUBLIC_URL=http://localhost
BRIDGE_ENRICHMENT_CONCURRENCY=3
# API container uses http://windmill_server:8000; local API uses your Windmill URL.
WINDMILL_URL=http://localhost
BRIDGE_ENABLE_ENRICHMENT_SMOKE=0
# When 1, a finished enrichment verifies and publishes the record. Unpublish still removes it from the public explorer.
BRIDGE_AUTO_PUBLISH_ENRICHMENT=0
OPENROUTER_API_KEY=
BRIDGE_ENRICHMENT_MODEL=google/gemini-2.5-flash-lite
# Seedline local assistant: mock (default) or live. Live uses the key above.
# Leave the assistant model blank to reuse BRIDGE_ENRICHMENT_MODEL.
SEEDLINE_ASSISTANT_MODE=mock
SEEDLINE_ASSISTANT_MODEL=
# Admin discovery at /admin/discovery uses this OpenRouter key and enrichment model.

# The CLI discovery worker is disabled until you intentionally configure a key, model, and rates.
# OPENAI_API_KEY=
# BRIDGE_DISCOVERY_MODEL=
# Use current prices for the chosen model and tool; values are USD.
# BRIDGE_INPUT_USD_PER_1M=
# BRIDGE_CACHED_INPUT_USD_PER_1M=
# BRIDGE_CACHE_WRITE_USD_PER_1M=
# BRIDGE_OUTPUT_USD_PER_1M=
# BRIDGE_WEB_SEARCH_USD_PER_CALL=
# Local Seedline founder demo. Explicitly opt in; never enable in preview or production.
APP_ENV=development
ENABLE_DEMO_MODE=false
